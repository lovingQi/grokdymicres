[Unit]
Description=Grok Register unattended batch runner
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/root/grokdymicres
ExecStart=/root/grokdymicres/deploy/run_xvfb.sh
Restart=always
RestartSec=120
Nice=10

[Install]
WantedBy=multi-user.target
